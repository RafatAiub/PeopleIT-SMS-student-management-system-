# =============================================================================
# PeopleNIT SMS — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME="PeopleNIT SMS"
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=sms_pass
POSTGRES_DB=sms_db
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=sms_redis_pass
REDIS_URL="redis://default:PASSWORD@HOST:6379"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Encrypts Google Authenticator (TOTP) secrets at rest. Optional locally — when
# unset it is derived from JWT_ACCESS_SECRET. REQUIRED in production: sharing
# one secret across both purposes means rotating JWT_ACCESS_SECRET would
# silently lock every 2FA user out of their account.
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_MIN_32_CHARS
# How long a half-finished login (password accepted, 2FA code still pending)
# stays valid before the user has to start over.
MFA_CHALLENGE_EXPIRES_IN=5m

# ── Payment Gateways (disabled by default — enable per institution) ───────────
# Student fee payments (modules/fees) go LIVE per gateway as soon as that
# gateway's credentials below are all filled in; with any credential blank the
# fee flow runs in DEMO MODE (simulated checkout page, no money charged,
# FeePaymentTransaction.isDemo = true). The *_ENABLED flags only gate the
# platform-subscription SSLCommerz client in modules/billing.
# Set to false to switch demo-mode fee payments OFF (a demo "success" marks the
# invoice paid without money moving) — recommended on a live school until real
# keys are configured. Default: enabled.
FEE_DEMO_PAYMENTS_ENABLED=true
# bKash (tokenized checkout — needs APP_KEY, APP_SECRET, USERNAME, PASSWORD)
BKASH_ENABLED=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad
NAGAD_ENABLED=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_MERCHANT_PUBLIC_KEY=
# Optional aliases (take precedence when set): Nagad's public key / your merchant private key,
# as PEM or bare base64.
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
# Optional: value sent in Nagad's X-KM-IP-V4 header (your server's whitelisted IP). Default 127.0.0.1.
NAGAD_CLIENT_IP=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# SSL Commerz
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# ── SMS Gateway ───────────────────────────────────────────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Greenweb (used for fee-due and absence reminder SMS — see reminderWorker.ts)
GREENWEB_API_TOKEN=
GREENWEB_BASE_URL=https://api.greenweb.com.bd/api.php
# Bulk messaging campaigns (/api/v1/campaigns) reuse these same variables — no
# new ones. SMS campaigns really send only when SMS_ENABLED=true AND
# GREENWEB_API_TOKEN is set; EMAIL campaigns only when EMAIL_ENABLED=true AND
# SMTP_HOST is set. Otherwise the campaign runs in DEMO mode: recipients are
# counted as "would send", nothing is transmitted, and the campaign is saved
# with isDemo=true.

# ── Email ─────────────────────────────────────────────────────────────────────
# Parsed by backend/src/config/env.ts. With EMAIL_ENABLED=false the email
# channel still renders every message through nodemailer's jsonTransport (so
# the pipeline and delivery log are exercised) but transmits nothing.
# Setting EMAIL_ENABLED=true REQUIRES SMTP_HOST, SMTP_USER and SMTP_PASS —
# the app fails fast at boot otherwise.
# To eyeball a real rendered email with no provider account at all, run:
#   cd backend && npx ts-node scripts/preview-email.ts
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="PeopleNIT SMS <noreply@peopleit.com>"

# ── AI (Claude → Gemini → demo) ──────────────────────────────────────────────
# Read directly from process.env by backend/src/modules/ai/ai.client.ts.
# Leave BOTH ANTHROPIC_API_KEY and GEMINI_API_KEY empty → DEMO mode: deterministic
# template text built from the institution's real data, responses carry
# demo: true and the UI shows a "Demo mode" banner. Never commit a real key.
ANTHROPIC_API_KEY=
# Model for everyday generation (comments, summaries, drafts). Default: claude-haiku-4-5
AI_MODEL=claude-haiku-4-5
# Model for heavier tasks (open-ended guardian-chat reply drafts). Code default: claude-sonnet-5; owner prefers the low-cost Haiku.
AI_MODEL_ADVANCED=claude-haiku-4-5
# Per-request timeout in ms (default 30000) and retries on 429/5xx (default 2, max 5).
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Provider order: Anthropic → Google Gemini → demo templates. An Anthropic
# 401/403 sends requests to Gemini for 10 minutes before Anthropic is retried.
# Gemini key (REST generateContent; key sent in the x-goog-api-key header).
GEMINI_API_KEY=
# Gemini model. Default: gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-lite-latest
# Voyage AI embeddings for semantic knowledge-base search. Empty → keyword ranking.
VOYAGE_API_KEY=
# Voyage embedding model. Default: voyage-3-lite
VOYAGE_MODEL=voyage-3-lite
# Reserved for future text-to-speech features — not used yet.
ELEVENLABS_API_KEY=

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# For S3/R2:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ── QR attendance check-in ────────────────────────────────────────────────────
# HMAC key that signs student/staff check-in QR codes (min 16 chars). Optional:
# when unset a key is derived from JWT_ACCESS_SECRET. Rotating it invalidates
# every printed check-in QR at once.
QR_SECRET=

# ── Public API (API keys) ─────────────────────────────────────────────────────
# Requests per minute allowed per API key on /api/v1/public-api/* (default 60).
# The global per-IP limiter still applies on top.
PUBLIC_API_RATE_LIMIT_PER_MIN=60

# ── Tenant data export ────────────────────────────────────────────────────────
# Directory where export ZIPs are written (kept 7 days, then deleted by the
# hourly cleanup job). Default: <OS temp dir>/peopleit-exports. On cPanel use a
# path OUTSIDE public_html, e.g. /home/<user>/peopleit-exports.
DATA_EXPORT_DIR=

# ── Usage cost estimates (BDT) ────────────────────────────────────────────────
# Unit prices used ONLY to estimate costs in the usage report (labelled
# "estimate" in the UI). Leave empty to show usage without a cost.
COST_PER_SMS_BDT=
COST_PER_EMAIL_BDT=
COST_PER_AI_CALL_BDT=
COST_PER_STORAGE_MB_BDT=

# ── Error tracking (optional) ─────────────────────────────────────────────────
# Sentry DSN. Empty → error tracking is a no-op. Also requires
# `npm install @sentry/node --workspace=backend`; see docs/redesign/OPERATIONS.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Fraction of requests traced for performance (0–1). Default 0 (errors only).
SENTRY_TRACES_SAMPLE_RATE=0

# Trust X-Forwarded-For from a reverse proxy/tunnel so rate limits apply per
# real client IP (e.g. "loopback" for a local tunnel, "1" behind one proxy hop).
# Leave empty when the app is reached directly.
TRUST_PROXY=
