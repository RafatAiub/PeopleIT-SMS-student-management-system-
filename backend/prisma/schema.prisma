// ── SaaS / Platform Layer ─────────────────────────────────────────────
// Global catalogue of gate-able features. Not tenant-scoped — one row per
// feature key, referenced by both PlanFeature (per-plan default) and
// InstitutionFeatureOverride (per-tenant override).
model FeatureFlag {
  id             String                       @id @default(cuid())
  key            String                       @unique
  description    String?
  defaultEnabled Boolean                      @default(false)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  planFeatures   PlanFeature[]
  overrides      InstitutionFeatureOverride[]
}

model PlanFeature {
  id         String      @id @default(cuid())
  planId     String
  plan       Plan        @relation(fields: [planId], references: [id])
  featureKey String
  feature    FeatureFlag @relation(fields: [featureKey], references: [key])
  enabled    Boolean     @default(true)
  limitValue Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([planId, featureKey])
  @@index([planId])
  @@index([featureKey])
}

model InstitutionFeatureOverride {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  featureKey    String
  feature       FeatureFlag @relation(fields: [featureKey], references: [key])
  enabled       Boolean
  limitValue    Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, featureKey])
  @@index([institutionId])
  @@index([featureKey])
}

enum UsageMetric {
  SMS
  EMAIL
  AI_CALL
  STORAGE_MB
}

model UsageRecord {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  metric        UsageMetric
  quantity      Int
  costBdt       Decimal?    @db.Decimal(10, 2)
  meta          Json?
  createdAt     DateTime    @default(now())

  @@index([institutionId, metric, createdAt])
}

model ApiKey {
  id              String      @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id])
  name            String
  keyPrefix       String
  keyHash         String      @unique
  scopes          String[]
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())

  @@index([institutionId])
}

model WebhookEndpoint {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id])
  url           String
  events        String[]
  secret        String
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  deliveries    WebhookDelivery[]

  @@index([institutionId])
}

// Scoped transitively through webhookId, same pattern as InvoiceItem.
model WebhookDelivery {
  id         String          @id @default(cuid())
  webhookId  String
  webhook    WebhookEndpoint @relation(fields: [webhookId], references: [id])
  event      String
  payload    Json
  statusCode Int?
  success    Boolean         @default(false)
  attempt    Int             @default(1)
  createdAt  DateTime        @default(now())

  @@index([webhookId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id               String                 @id @default(cuid())
  institutionId    String
  institution      Institution            @relation(fields: [institutionId], references: [id])
  subject          String
  description      String                 @db.Text
  status           TicketStatus           @default(OPEN)
  priority         String                 @default("NORMAL")
  createdByUserId  String
  createdBy        User                   @relation("SupportTicketCreator", fields: [createdByUserId], references: [id])
