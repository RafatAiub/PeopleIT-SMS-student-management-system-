// ── Phase 2: Academic Results ────────────────────────────────────────
model Exam {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  name          String // e.g. "Term 1", "Final Exam"
  // Defaulted so the Exam module's create form (name/session/semester/
  // classes only) needn't ask for dates — they're re-derived from the
  // exam's timetable (min/max date) whenever timetable rows are saved.
  startDate      DateTime        @default(now())
  endDate        DateTime        @default(now())
  isActive       Boolean         @default(true)
  description    String?
  academicYearId String?
  academicYear   AcademicYear?   @relation(fields: [academicYearId], references: [id])
  semesterId     String?
  semester       Semester?       @relation(fields: [semesterId], references: [id])
  // Controls student/guardian visibility of this exam's results.
  isPublished    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  results        ExamResult[]
  classes        ExamClass[]
  timetable      ExamTimetable[]

  @@index([institutionId])
  @@index([academicYearId])
}

// Which classes an exam is held for. An exam with no ExamClass rows (e.g.
// the auto-seeded Mid Term / Half Yearly / Final Term) applies to every class.
model ExamClass {
  id      String @id @default(cuid())
  examId  String
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([examId, classId])
  @@index([classId])
}

// One subject paper of an exam for one class — date, time window, total and
// passing marks.
model ExamTimetable {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId       String
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  totalMarks    Decimal     @db.Decimal(6, 2)
  passingMarks  Decimal     @db.Decimal(6, 2)
  date          DateTime    @db.Date
  startTime     String // "HH:mm"
  endTime       String // "HH:mm"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examId, classId, subjectId])
  @@index([institutionId])
  @@index([classId])
}


model ExamResult {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  subject       String // e.g. "Math", "Science"
  marksObtained Decimal     @db.Decimal(5, 2)
  maxMarks      Decimal     @default(100.00) @db.Decimal(5, 2)
  grade         String? // e.g. "A+", "B"
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, examId, studentId, subject])
  @@index([institutionId])
  @@index([studentId])
  @@index([examId])
}

// ── Phase 2: Timetables ──────────────────────────────────────────────
model TimetableSlot {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  dayOfWeek     String // MONDAY, TUESDAY, etc.
  startTime     String // e.g. "09:00"
  endTime       String // e.g. "09:45"
  className     String // e.g. "Class 8"
  sectionName   String // e.g. "A"
  subject       String // e.g. "Math"
  roomNumber    String?
  teacherId     String?
  teacher       Teacher?    @relation(fields: [teacherId], references: [id])

  @@index([institutionId])
  @@index([branchId])
