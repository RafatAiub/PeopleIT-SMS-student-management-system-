  @@index([institutionId])
  @@index([categoryId])
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model StockMovement {
  id              String            @id @default(cuid())
  institutionId   String
  institution     Institution       @relation(fields: [institutionId], references: [id])
