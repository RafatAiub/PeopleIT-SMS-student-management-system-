  @@index([institutionId])
}

// ── Admissions CRM ───────────────────────────────────────────────────
enum EnquiryStatus {
  NEW
  CONTACTED
  VISITED
  APPLIED
  ENROLLED
  LOST
}

model AdmissionEnquiry {
