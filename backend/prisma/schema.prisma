  requestedByUserId String
  requestedBy       User        @relation(fields: [requestedByUserId], references: [id])
  status            String      @default("PENDING")
  fileUrl           String?
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  completedAt       DateTime?

  @@index([institutionId])
  @@index([status])
