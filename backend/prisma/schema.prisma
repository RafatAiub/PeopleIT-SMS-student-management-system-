generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Multi-tenant anchor ──────────────────────────────────────────────
model Institution {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  logoUrl                 String?
  address                 String?
  phone                   String?
  email                   String?
  country                 String                   @default("BD")
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  branches                Branch[]
  users                   User[]
  students                Student[]
  feeCategories           FeeCategory[]
  invoices                Invoice[]
  auditLogs               AuditLog[]
  studentDocs             StudentDocument[]
  guardians               Guardian[]
  attendances             Attendance[]
  exams                   Exam[]
  examResults             ExamResult[]
  timetableSlots          TimetableSlot[]
  notices                 Notice[]
  libraryBooks            LibraryBook[]
  libraryIssues           LibraryIssue[]
  vehicles                TransportVehicle[]
  routes                  TransportRoute[]
  transportAssignments    TransportAssignment[]
  themeColor              String?                  @default("#0f172a")
  heroTitle               String?                  @default("Welcome to Our School")
  heroSubtitle            String?                  @default("Empowering students for a better tomorrow.")
  aboutText               String?                  @db.Text
  contactEmail            String?
  contactPhone            String?
  staffProfiles           StaffProfile[]
  staffRoles              StaffRole[]
  classFees               ClassFee[]
  notificationBroadcasts  NotificationBroadcast[]
  payrollRecords          PayrollRecord[]
  messages                Message[]
  subjects                Subject[]
  subjectOfferings        SubjectOffering[]
  idCardTemplates         IdCardTemplate[]
  idCards                 IdCard[]
  lectureMaterials        LectureMaterial[]
  lectureMaterialComments LectureMaterialComment[]
  assignments             Assignment[]
  trialEndsAt             DateTime?
  subscription            Subscription?
  subscriptionPayments    SubscriptionPayment[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  notificationPrefs       NotificationPreference[]
  notificationTemplates   NotificationTemplate[]
  mediums                 Medium[]
  streams                 Stream[]
  shifts                  Shift[]
  semesters               Semester[]
  studentCategories       StudentCategory[]
  leaveTypes              LeaveType[]
  leaveRequests           LeaveRequest[]
  examTimetables          ExamTimetable[]
  holidays                Holiday[]
  holidayCalendars        HolidayCalendar[]
  events                  Event[]

  // ── Institution settings (Wave C) ──────────────────────────────────
  timezone        String  @default("Asia/Dhaka")
  dateFormat      String  @default("D MMM YYYY")
  numeralSystem   String  @default("latn")
  currency        String  @default("BDT")
  defaultLanguage String  @default("en")
  primaryColor    String?

  // ── Wave C feature foundation relations ────────────────────────────
  feePaymentTransactions FeePaymentTransaction[]
  concessions            Concession[]
  studentConcessions     StudentConcession[]
  feeSchedules           FeeSchedule[]
  invoiceBatches         InvoiceBatch[]
  gradingScales          GradingScale[]
  promotionRecords       PromotionRecord[]
  subjectAttendances     SubjectAttendance[]
  staffAttendances       StaffAttendance[]
  qrCheckIns             QrCheckIn[]
  salaryComponents       SalaryComponent[]
  staffSalaryComponents  StaffSalaryComponent[]
  libraryFineRule        LibraryFineRule?
  transportStops         TransportStop[]
  assetCategories        AssetCategory[]
  assets                 Asset[]
  assetAllocations       AssetAllocation[]
  assetMaintenances      AssetMaintenance[]
  stockItems             StockItem[]
  stockMovements         StockMovement[]
  purchaseRecords        PurchaseRecord[]
  admissionEnquiries     AdmissionEnquiry[]
  customFieldDefinitions CustomFieldDefinition[]
  messageCampaigns       MessageCampaign[]
  messageGroups          MessageGroup[]
  teacherTasks           TeacherTask[]
  performanceReviews     PerformanceReview[]
  featureOverrides       InstitutionFeatureOverride[]
  usageRecords           UsageRecord[]
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
  supportTickets         SupportTicket[]
  onboardingProgress     OnboardingProgress?
  dataExportJobs         DataExportJob[]
  aiInteractions         AiInteraction[]
  aiDrafts               AiDraft[]
  knowledgeDocuments     KnowledgeDocument[]
  savedReportViews       SavedReportView[]
  reportSchedules        ReportSchedule[]

  // ── Website builder (Sites) ────────────────────────────────────────
  site      Site?
  siteMedia SiteMedia[]

  // ── Website v3 — DSHE profile fields (Track B1) ─────────────────────
  // Additive nullable columns directly on Institution rather than a new
  // SiteProfile model: these are singular (one-per-institution) facts,
  // exactly like the existing aboutText/contactEmail/heroTitle columns
  // above — a separate 1:1 model would only earn its keep for one-to-many
  // data. The two officer contacts and "head of institution" are each a
  // small, optional struct (and headOfInstitution is a union: an existing
  // staff member OR a free-typed name+photo+designation), so they are
  // stored as Json rather than 3-4 near-always-null flat columns each;
  // shape is enforced by sites.portal.dto.ts, not the database.
  nameBn           String? // প্রতিষ্ঠানের নাম (বাংলা)
  eiin             String? // Educational Institution Identification Number
  establishedYear  Int?
  mpoInfo          String? @db.Text // MPO / নাতিয়করণ status and reference number
  recognitionInfo  String? @db.Text // পাঠদানের অনুমতি ও স্বীকৃতি
  // { userId?: string; name?: string; photoUrl?: string; designation?: string }
  headOfInstitution Json?
  // { name?: string; designation?: string; phone?: string; email?: string }
  informationOfficer Json?
  // { name?: string; designation?: string; phone?: string; email?: string }
  complaintsOfficer  Json?

  siteCommitteeMembers   SiteCommitteeMember[]
  siteAlbums             SiteAlbum[]
  siteDownloads          SiteDownload[]
  siteAdmissionCirculars SiteAdmissionCircular[]
}

// ── Institution Applications (public self-service onboarding) ─────────
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model InstitutionApplication {
  id                   String            @id @default(cuid())
  institutionName      String
  slug                 String // proposed EIIN/code, same numeric convention as Institution.slug
  address              String?
  phone                String?
  applicantFirstName   String
  applicantLastName    String
  applicantEmail       String
  applicantPhone       String?
  message              String?           @db.Text
  status               ApplicationStatus @default(PENDING)
  rejectionReason      String?
  reviewedByUserId     String?
  reviewedBy           User?             @relation(fields: [reviewedByUserId], references: [id])
  reviewedAt           DateTime?
  createdInstitutionId String? // set on approval, for traceability
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status])
  @@index([applicantEmail])
}

// ── Authorized Email Allowlist ──────────────────────────────────────────
// Gates the public institution-application form: only an email a Super Admin
// has pre-approved here may submit an application. Stored lowercased/trimmed
// to match the normalization already applied to applicantEmail in the DTO.
model AuthorizedEmail {
  id            String   @id @default(cuid())
  email         String   @unique
  note          String?
  addedByUserId String?
  addedBy       User?    @relation(fields: [addedByUserId], references: [id])
  createdAt     DateTime @default(now())
  leads         Lead[]

  @@index([email])
}

// ── Public Lead Capture (ad-driven traffic, pre-tenant) ─────────────────
// Ungated counterpart to InstitutionApplication: a lightweight contact-info
// drop for cold traffic with no pre-approved email, captured before any
// institution/tenant exists. Deliberately NOT tenant-scoped — no
// institutionId. Sales qualifies and manually authorizes via
// authorizedEmailId once ready to let the contact submit the real,
// AuthorizedEmail-gated institution application.
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

model Lead {
  id                String           @id @default(cuid())
  name              String
  phone             String
  email             String?
  institutionName   String?
  institutionType   String?
  message           String?          @db.Text
  source            String?
  status            LeadStatus       @default(NEW)
  authorizedEmailId String?
  authorizedEmail   AuthorizedEmail? @relation(fields: [authorizedEmailId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([phone])
}

// ── Platform Subscription Billing (SSLCommerz) ─────────────────────────
enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum SubscriptionPaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  SSLCOMMERZ
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  studentCap    Int? // null = unlimited (top tier)
  description   String?        @db.Text
  isArchived    Boolean        @default(false) // never hard-delete — referenced by historical Subscription/SubscriptionPayment rows
  displayOrder  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prices        PlanPrice[]
  subscriptions Subscription[]
  features      PlanFeature[]

  @@index([isArchived])
}

model PlanPrice {
  id           String                @id @default(cuid())
  planId       String
  plan         Plan                  @relation(fields: [planId], references: [id])
  billingCycle BillingCycle
  amount       Decimal               @db.Decimal(10, 2) // BDT, whole-cycle price (not per-month)
  currency     String                @default("BDT")
  isActive     Boolean               @default(true) // superseded prices kept for historical SubscriptionPayment FK integrity
  createdAt    DateTime              @default(now())
  payments     SubscriptionPayment[]

  @@index([planId])
}

model Subscription {
  id                 String                @id @default(cuid())
  institutionId      String                @unique
  institution        Institution           @relation(fields: [institutionId], references: [id])
  planId             String
  plan               Plan                  @relation(fields: [planId], references: [id])
  billingCycle       BillingCycle
  status             SubscriptionStatus    @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  payments           SubscriptionPayment[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([graceEndsAt])
}

model SubscriptionPayment {
  id                    String                    @id @default(cuid())
  subscriptionId        String
  subscription          Subscription              @relation(fields: [subscriptionId], references: [id])
  institutionId         String // denormalized for cross-tenant super-admin queries without join
  institution           Institution               @relation(fields: [institutionId], references: [id])
  planPriceId           String?
  planPrice             PlanPrice?                @relation(fields: [planPriceId], references: [id])
  amount                Decimal                   @db.Decimal(10, 2)
  currency              String                    @default("BDT")
  billingCycle          BillingCycle
  gateway               PaymentGateway            @default(SSLCOMMERZ)
  gatewayTransactionId  String? // our tran_id sent to SSLCommerz
  gatewayValId          String? // val_id returned by SSLCommerz, used for validationserverAPI lookup
  status                SubscriptionPaymentStatus @default(INITIATED)
  initiatedByUserId     String?
  isManualOverride      Boolean                   @default(false)
  overrideReason        String?                   @db.Text
  overriddenByUserId    String?
  rawGatewayResponse    Json?
  gatewayPaymentUrl     String? // redisplayable if a super-admin-generated link hasn't been consumed yet
  generatedBySuperAdmin Boolean                   @default(false) // distinguishes a super-admin-initiated payment request from tenant self-checkout, without a User join
  refundRefId           String? // SSLCommerz refund_ref_id, set once a refund is initiated
  refundedAt            DateTime? // set only once a refund query confirms completion
  refundedByUserId      String?
  refundRawResponse     Json? // kept separate from rawGatewayResponse (the original payment's validation record)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([gatewayTransactionId])
  @@index([institutionId])
  @@index([subscriptionId])
  @@index([status])
}

// ── Branch / Campus ──────────────────────────────────────────────────
model Branch {
  id               String            @id @default(cuid())
  institutionId    String
  institution      Institution       @relation(fields: [institutionId], references: [id])
  name             String
  address          String?
  phone            String?
  email            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  classes          Class[]
  students         Student[]
  TimetableSlot    TimetableSlot[]
  lectureMaterials LectureMaterial[]
  assignments      Assignment[]
  users            User[]

  @@index([institutionId])
}

// ── Academic structure ───────────────────────────────────────────────
model AcademicYear {
  id             String            @id @default(cuid())
  institutionId  String
  label          String // e.g. "2024-2025"
  startDate      DateTime
  endDate        DateTime
  // The institution's default ("current") session year — exactly one per
  // institution, enforced in session-year.service.ts.
  isCurrent      Boolean           @default(false)
  students       Student[]
  events         Event[]
  exams          Exam[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  promotionsFrom PromotionRecord[] @relation("PromotionFromYear")
  promotionsTo   PromotionRecord[] @relation("PromotionToYear")

  @@index([institutionId])
}

model Class {
  id             String            @id @default(cuid())
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  name           String // e.g. "Grade 5"
  level          Int               @default(1)
  sections       Section[]
  students       Student[]
  mediumId       String?
  medium         Medium?           @relation(fields: [mediumId], references: [id])
  streamId       String?
  stream         Stream?           @relation(fields: [streamId], references: [id])
  shiftId        String?
  shift          Shift?            @relation(fields: [shiftId], references: [id])
  semesterId     String?
  semester       Semester?         @relation(fields: [semesterId], references: [id])
  classFees      ClassFee[]
  examClasses    ExamClass[]
  examTimetables ExamTimetable[]
  feeSchedules   FeeSchedule[]
  invoiceBatches InvoiceBatch[]
  notices        Notice[]
  promotionsFrom PromotionRecord[] @relation("PromotionFromClass")
  promotionsTo   PromotionRecord[] @relation("PromotionToClass")

  @@index([branchId])
  @@index([mediumId])
  @@index([streamId])
  @@index([shiftId])
  @@index([semesterId])
}

model Section {
  id             String            @id @default(cuid())
  classId        String
  class          Class             @relation(fields: [classId], references: [id])
  name           String // e.g. "A", "B"
  students       Student[]
  classTeacherId String?
  classTeacher   Teacher?          @relation(name: "ClassTeacher", fields: [classTeacherId], references: [id])
  invoiceBatches InvoiceBatch[]
  notices        Notice[]
  promotionsFrom PromotionRecord[] @relation("PromotionFromSection")
  promotionsTo   PromotionRecord[] @relation("PromotionToSection")

  @@index([classId])
  @@index([classTeacherId])
}

// ── Academics lookups (Medium/Stream/Shift/Semester) ──────────────────
// Optional classification axes a Class can be tagged with. Admin-manageable
// via the `academics` module; institution-scoped, name-unique per tenant.
model Medium {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  classes       Class[]
  createdAt     DateTime    @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Stream {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  classes       Class[]
  createdAt     DateTime    @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Shift {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  classes       Class[]
  createdAt     DateTime    @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Semester {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  classes       Class[]
  exams         Exam[]
  createdAt     DateTime    @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

// Admin-manageable, institution-scoped, name-unique lookup a Student can be
// tagged with (e.g. "General", "Freedom Fighter Quota", "Physically
// Challenged") — same shape/CRUD pattern as Medium/Stream/Shift/Semester
// above, just attached to Student instead of Class.
model StudentCategory {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  students      Student[]
  createdAt     DateTime    @default(now())

  @@unique([institutionId, name])
  @@index([institutionId])
}

// ── Curriculum (NCTB-aligned subject offerings) ────────────────────────
// Additive, institution-scoped catalogue driving the Results module's
// subject list + default max marks per class/group/paper — replaces what
// was previously a hardcoded frontend array (see MarksEntry.tsx). Keyed by
// className (not a Class.id FK), matching the free-text class convention
// already used by TimetableSlot.className/sectionName, rather than
// requiring every institution's Class rows to be pre-resolved for seeding.
// Does not touch ExamResult — that keeps storing subject as a plain string
// (e.g. "Bangla 1st Paper"), so no existing results data is migrated.
enum StudentGroup {
  NONE // Class 1-8 — no group split
  SCIENCE
  COMMERCE
  ARTS
}

enum SubjectPaper {
  NONE // single combined mark
  FIRST
  SECOND
}

model Subject {
  id                 String              @id @default(cuid())
  institutionId      String
  institution        Institution         @relation(fields: [institutionId], references: [id])
  name               String // e.g. "Bangla", "Physics"
  offerings          SubjectOffering[]
  createdAt          DateTime            @default(now())
  subjectAttendances SubjectAttendance[]
  examTimetables     ExamTimetable[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model SubjectOffering {
  id              String       @id @default(cuid())
  institutionId   String
  institution     Institution  @relation(fields: [institutionId], references: [id])
  className       String // e.g. "Class 8" — matches Class.name
  group           StudentGroup @default(NONE) // Class 9+ selects by group; NONE applies to all
  subjectId       String
  subject         Subject      @relation(fields: [subjectId], references: [id])
  paper           SubjectPaper @default(NONE)
  defaultMaxMarks Decimal      @default(100.00) @db.Decimal(5, 2)
  isGraded        Boolean      @default(true) // false = co-curricular/pass-fail, excluded from numeric mark entry
  displayOrder    Int          @default(0)
  createdAt       DateTime     @default(now())

  // Explicit map: the field list is long enough that Prisma's default name
  // exceeds Postgres's 63-byte identifier limit and would get silently
  // truncated by Postgres in a way that doesn't match what a hand-written
  // migration can predict — pinned explicitly so schema and migration.sql
  // are guaranteed to agree.

  @@unique([institutionId, className, group, subjectId, paper], map: "SubjectOffering_unique_offering")
  @@index([institutionId, className, group])
  @@index([subjectId])
}

// ── User & Role Management ───────────────────────────────────────────
enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_OFFICER
  GUARDIAN
  STUDENT
  MANAGEMENT
}

model User {
  id            String       @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  email         String       @unique
  passwordHash  String
  role          UserRole
  firstName     String
  lastName      String
  // Stored canonically as 8801XXXXXXXXX (see utils/phone.ts). Unique because
  // it is a login identifier — two accounts sharing a number would make
  // phone-based sign-in ambiguous. Still nullable: admin-created accounts and
  // legacy rows may have none.
  phone         String?      @unique
  avatarUrl     String?

  // ── Verification ──────────────────────────────────────────────────────
  // Timestamps rather than booleans: "when did they confirm this" is useful
  // for support and audit, and null reads the same as false.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // ── Two-step verification ─────────────────────────────────────────────
  // twoFactorSecret holds the base32 TOTP seed, encrypted at rest; it stays
  // populated only while TOTP is the active method.
  twoFactorEnabled    Boolean          @default(false)
  twoFactorMethod     TwoFactorMethod?
  twoFactorSecret     String?
  twoFactorVerifiedAt DateTime?
  backupCodes         BackupCode[]

  // Self-registered users wait here until an admin approves them; accounts
  // created by an admin or by application approval start out ACTIVE.
  status UserStatus @default(ACTIVE)

  isActive                 Boolean                  @default(true)
  // Website v3 (Track B2) — opt-in to appear in the public staff/teacher
  // directory. Defaults to false (owner decision 3: hidden until opted in).
  // Lives on User, not Teacher/StaffProfile: it's the one place guaranteed
  // to exist for every account regardless of role, so a teacher without a
  // StaffProfile row (or a staff member without a Teacher row) still has
  // a single, unambiguous place to opt in.
  showOnWebsite            Boolean                  @default(false)
  lastLoginAt              DateTime?
  failedLoginAttempts      Int                      @default(0)
  lockedUntil              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  verificationTokens       VerificationToken[]
  otpCodes                 OtpCode[]
  studentProfile           Student?                 @relation("StudentUser")
  teacherProfile           Teacher?
  guardianProfile          Guardian?
  staffProfile             StaffProfile?            @relation("StaffUser")
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  sentMessages             Message[]                @relation("SentMessages")
  receivedMessages         Message[]                @relation("ReceivedMessages")
  reviewedApplications     InstitutionApplication[]
  addedAuthorizedEmails    AuthorizedEmail[]
  uploadedLectureMaterials LectureMaterial[]
  lectureMaterialComments  LectureMaterialComment[]
  createdAssignments       Assignment[]
  notifications            Notification[]
  notificationPrefs        NotificationPreference[]
  leaveRequests            LeaveRequest[]           @relation("LeaveApplicant")
  leaveReviews             LeaveRequest[]           @relation("LeaveReviewer")

  // ── Wave C feature foundation relations ────────────────────────────
  initiatedFeePaymentTransactions FeePaymentTransaction[]
  invoiceBatchesCreated           InvoiceBatch[]
  promotionsMade                  PromotionRecord[]
  markedSubjectAttendances        SubjectAttendance[]
  staffAttendances                StaffAttendance[]       @relation("StaffAttendanceStaff")
  markedStaffAttendances          StaffAttendance[]       @relation("StaffAttendanceMarker")
  qrCheckIns                      QrCheckIn[]
  assetAllocations                AssetAllocation[]
  stockMovementsCreated           StockMovement[]
  purchaseRecordsCreated          PurchaseRecord[]
  assignedAdmissionEnquiries      AdmissionEnquiry[]
  createdMessageCampaigns         MessageCampaign[]
  createdMessageGroups            MessageGroup[]
  messageGroupMemberships         MessageGroupMember[]
  assignedTeacherTasks            TeacherTask[]           @relation("TeacherTaskAssignee")
  createdTeacherTasks             TeacherTask[]           @relation("TeacherTaskCreator")
  performanceReviewsGiven         PerformanceReview[]
  createdApiKeys                  ApiKey[]
  createdSupportTickets           SupportTicket[]         @relation("SupportTicketCreator")
  assignedSupportTickets          SupportTicket[]         @relation("SupportTicketAssignee")
  supportTicketMessages           SupportTicketMessage[]
  dataExportJobs                  DataExportJob[]
  aiInteractions                  AiInteraction[]
  createdAiDrafts                 AiDraft[]               @relation("AiDraftCreator")
  reviewedAiDrafts                AiDraft[]               @relation("AiDraftReviewer")
  createdKnowledgeDocuments       KnowledgeDocument[]
  savedReportViews                SavedReportView[]
  createdReportSchedules          ReportSchedule[]

  @@index([institutionId])
  @@index([branchId])
  @@index([email])
  @@index([phone])
  @@index([status])
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL // self-registered, awaiting an institution admin
  REJECTED
  SUSPENDED
}

enum TwoFactorMethod {
  EMAIL // 6-digit code sent to the verified email address
  TOTP // Google Authenticator / any RFC-6238 app
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use, expiring links emailed to a user (verify address, reset
/// password). `token` stores a SHA-256 hash — the raw value only ever exists
/// in the email itself, so a database leak cannot be replayed.
model VerificationToken {
  id         String              @id @default(cuid())
  token      String              @unique
  purpose    VerificationPurpose
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Denormalised so a pending address change can be verified before it is
  // written onto the User row.
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum OtpPurpose {
  LOGIN_2FA
  PHONE_VERIFICATION // reserved — phone OTP is not switched on yet
}

/// Short-lived numeric codes. Hashed like verification tokens, and
/// attempt-capped so a 6-digit code cannot be brute-forced within its window.
model OtpCode {
  id         String     @id @default(cuid())
  codeHash   String
  purpose    OtpPurpose
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// One-time recovery codes issued when 2FA is enabled — the escape hatch for
/// a lost authenticator device. Hashed; deleted as they are spent.
model BackupCode {
  id       String    @id @default(cuid())
  codeHash String
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt   DateTime?

  @@index([userId])
}

model Permission {
  id            String   @id @default(cuid())
  institutionId String
  role          UserRole
  resource      String // e.g. "student", "invoice"
  action        String // e.g. "read", "write", "delete"
  granted       Boolean  @default(true)

  @@unique([institutionId, role, resource, action])
  @@index([institutionId])
}

// ── Student Information ──────────────────────────────────────────────
model Student {
  id                   String                @id @default(cuid())
  institutionId        String
  institution          Institution           @relation(fields: [institutionId], references: [id])
  branchId             String?
  branch               Branch?               @relation(fields: [branchId], references: [id])
  classId              String?
  class                Class?                @relation(fields: [classId], references: [id])
  sectionId            String?
  section              Section?              @relation(fields: [sectionId], references: [id])
  academicYearId       String?
  academicYear         AcademicYear?         @relation(fields: [academicYearId], references: [id])
  userId               String?               @unique
  user                 User?                 @relation("StudentUser", fields: [userId], references: [id])
  studentId            String // e.g. Admissions/Student Registration No
  rollNumber           String?
  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  gender               String?
  email                String?
  phone                String?
  address              String? // Current Address
  permanentAddress     String?
  bloodGroup           String?
  religion             String?
  nationality          String                @default("Bangladeshi")
  department           String? // required (enforced in DTO) for Class 9/10 students, e.g. Science/Commerce/Arts
  categoryId           String?
  category             StudentCategory?      @relation(fields: [categoryId], references: [id])
  caste                String?
  height               String? // deliberately free-text, not numeric
  weight               String? // deliberately free-text, not numeric
  hobbies              String? // comma-separated free text, e.g. "Reading,Singing"
  avatarUrl            String?
  admissionDate        DateTime              @default(now())
  status               String                @default("ACTIVE") // ACTIVE, INACTIVE, GRADUATED, TRANSFERRED
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  guardians            GuardianStudent[]
  invoices             Invoice[]
  documents            StudentDocument[]
  Attendance           Attendance[]
  ExamResult           ExamResult[]
  libraryIssues        LibraryIssue[]
  transportAssignments TransportAssignment[]
  idCards              IdCard[]

  // ── Admissions/profile extras (Wave C) ─────────────────────────────
  applicationStatus        String?
  previousSchool           String?
  previousClass            String?
  medicalNotes             String? @db.Text
  allergies                String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  customFields             Json?

  // ── Wave C feature foundation relations ────────────────────────────
  feePaymentTransactions FeePaymentTransaction[]
  concessions            StudentConcession[]
  promotionRecords       PromotionRecord[]
  subjectAttendances     SubjectAttendance[]
  qrCheckIns             QrCheckIn[]
  admissionEnquiries     AdmissionEnquiry[]
  performanceReviews     PerformanceReview[]

  @@index([institutionId])
  @@index([branchId])
  @@index([studentId])
  @@index([status])
  @@index([categoryId])
  @@index([institutionId, classId, sectionId])
}

model StudentDocument {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  name          String
  type          String // e.g. "BIRTH_CERT", "NID", "PHOTO"
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  uploadedAt    DateTime    @default(now())

  @@index([studentId])
  @@index([institutionId])
}

model Guardian {
  id             String            @id @default(cuid())
  institutionId  String
  institution    Institution       @relation(fields: [institutionId], references: [id])
  userId         String?           @unique
  user           User?             @relation(fields: [userId], references: [id])
