  createdAt     DateTime    @default(now())

  @@index([institutionId, feature, createdAt])
  @@index([userId])
}

enum AiDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  PUBLISHED
}

// Staff review gate before an AI-generated draft (e.g. a report comment, a
// notice, a message) is shown to guardians/students.
model AiDraft {
