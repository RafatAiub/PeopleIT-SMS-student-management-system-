// ── Lecture Materials (per-class/section resource library) ────────────
model LectureMaterial {
  id               String                   @id @default(cuid())
  institutionId    String
  institution      Institution              @relation(fields: [institutionId], references: [id])
  branchId         String
  branch           Branch                   @relation(fields: [branchId], references: [id])
  className        String // e.g. "Class 8"
  sectionName      String // e.g. "A"
  subject          String // e.g. "Mathematics"
  title            String
  description      String?                  @db.Text
  resourceType     String                   @default("NOTE") // NOTE, SLIDE, VIDEO, PDF, LINK
  fileUrl          String // external link (Drive/YouTube/hosted file/etc.)
  uploadedByUserId String
  uploadedBy       User                     @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  comments         LectureMaterialComment[]

  @@index([institutionId])
  @@index([branchId])
  @@index([uploadedByUserId])
}

// Google-Classroom-style comment thread under a single lecture material.
// Read by anyone who can see the material; posted by Teacher/Student only
// (enforced in lecture.routes.ts) — Admin stays read-only, Guardian too.
model LectureMaterialComment {
  id                String          @id @default(cuid())
  institutionId     String
  institution       Institution     @relation(fields: [institutionId], references: [id])
  lectureMaterialId String
  lectureMaterial   LectureMaterial @relation(fields: [lectureMaterialId], references: [id], onDelete: Cascade)
  authorUserId      String
  author            User            @relation(fields: [authorUserId], references: [id])
  content           String          @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([institutionId])
  @@index([lectureMaterialId])
  @@index([authorUserId])
}

// ── Classwork (teacher/student-assigned homework — separate from the
// Stream's free-form LectureMaterial posts; not shown in the Stream feed) ──
model Assignment {
  id              String      @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id])
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id])
  className       String // e.g. "Class 8"
  sectionName     String // e.g. "A"
  subject         String // e.g. "Mathematics"
  title           String
  instructions    String?     @db.Text
  resourceType    String? // NOTE, SLIDE, VIDEO, PDF, LINK, IMAGE — optional attachment
  fileUrl         String? // optional attachment link
  dueDate         DateTime? // required when created by a Teacher (an assigned task); a Student's own submission has none
  createdByUserId String
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // A Student's submission always points back to the Teacher's top-level
  // assignment it answers (null on the assignment itself). Cascades so
  // deleting the assignment cleans up its submissions. One submission per
  // student per assignment — resubmitting means editing the existing row.
  parentAssignmentId String?
  parentAssignment   Assignment?  @relation("AssignmentSubmissions", fields: [parentAssignmentId], references: [id], onDelete: Cascade)
  submissions        Assignment[] @relation("AssignmentSubmissions")

  @@unique([parentAssignmentId, createdByUserId])
  @@index([institutionId])
  @@index([branchId])
  @@index([createdByUserId])
  @@index([parentAssignmentId])
}

// ── Phase 2: Communication Hub (Notice Board) ─────────────────────────
model Notice {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  title         String
  content       String      @db.Text
  audience      String // ALL, TEACHERS, GUARDIANS, STUDENTS
  isActive      Boolean     @default(true)
  publishedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())
  classId       String?
  class         Class?      @relation(fields: [classId], references: [id])
  sectionId     String?
  section       Section?    @relation(fields: [sectionId], references: [id])
  scheduledAt   DateTime?

  @@index([institutionId])
  @@index([classId])
  @@index([sectionId])
}

// ── Notifications ────────────────────────────────────────────────────
// Per-recipient, actionable notification. Distinct from Notice (a broadcast
// announcement with no per-user state): a Notification is addressed to one
// user, is typed, carries a deep-link payload, and tracks its own read state.
model Notification {
  id              String                 @id @default(cuid())
  institutionId   String
  institution     Institution            @relation(fields: [institutionId], references: [id])
  recipientUserId String
  recipient       User                   @relation(fields: [recipientUserId], references: [id])
  type            String // INVOICE_ISSUED, PAYMENT_RECEIVED, FEE_REMINDER, ABSENCE_ALERT
  title           String
  body            String                 @db.Text
  data            Json? // deep-link payload, e.g. { "link": "/fees", "invoiceId": "..." }
  readAt          DateTime?
  createdAt       DateTime               @default(now())
  deliveries      NotificationDelivery[]

  @@index([institutionId, recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// One row per (notification x channel) send attempt. Two jobs it does:
//   1. Idempotency — `dedupeKey` is unique, so a replayed queue job, a retried
//      webhook, or a double-clicked action can never double-send.
//   2. Observability — a durable record of what was actually delivered, to
//      whom, through which provider, and why it failed.
model NotificationDelivery {
  id             String                     @id @default(cuid())
  institutionId  String
  institution    Institution                @relation(fields: [institutionId], references: [id])
  notificationId String?
  notification   Notification?              @relation(fields: [notificationId], references: [id])
  channel        NotificationChannel
  recipient      String // email address, phone number, or userId for IN_APP
  templateKey    String // the notification type this was rendered from
  status         NotificationDeliveryStatus @default(QUEUED)
  dedupeKey      String                     @unique
  providerRef    String? // provider message id, when the channel returns one
  error          String?                    @db.Text
  attempts       Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([institutionId, status])
  @@index([institutionId, channel, createdAt])
}

// Absence of a row means ENABLED. Users only ever write rows to opt OUT, so a
// newly-added notification type reaches everyone by default instead of being
// silently suppressed for every existing user.
// Per-tenant override of a bundled default template (templates.defaults.ts).
// A missing row is normal, not an error: the bundled default renders instead,
// so a freshly-onboarded institution needs no seeding.
model NotificationTemplate {
  id            String              @id @default(cuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id])
  key           String // the notification type, e.g. INVOICE_ISSUED
  channel       NotificationChannel
  subject       String? // email subject / in-app title; unused for SMS
  body          String              @db.Text
  isActive      Boolean             @default(true)
  updatedAt     DateTime            @updatedAt
  createdAt     DateTime            @default(now())

  @@unique([institutionId, key, channel])
  @@index([institutionId])
}

model NotificationPreference {
  id            String              @id @default(cuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id])
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  type          String
  channel       NotificationChannel
  enabled       Boolean             @default(true)
  updatedAt     DateTime            @updatedAt

  @@unique([userId, type, channel])
  @@index([institutionId, userId])
}

// ── Phase 3: Library Management ──────────────────────────────────────
model LibraryBook {
