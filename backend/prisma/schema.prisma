// ══════════════════════════════════════════════════════════════════════
// Website builder (Sites) — one public school website per institution:
// Puck-JSON pages with draft/published copies and version history, media
// metadata (files live on Cloudinary), blog posts, forms + submissions and
// custom domains. Additive only; see docs/redesign/WEBSITE_BRIEF.md.
// Child tables carry institutionId as a denormalised tenant key (indexed);
// integrity comes from the cascade to their Site/Page/Form parent.
// ══════════════════════════════════════════════════════════════════════

enum SiteStatus {
  DRAFT
  PUBLISHED
}

enum SiteMediaKind {
  IMAGE
  VIDEO
  FILE
}

enum SiteDomainStatus {
  PENDING_DNS
  VERIFYING
  ACTIVE
  FAILED
}

enum SiteFormTarget {
  ENQUIRY
  INBOX
}

model Site {
  id            String           @id @default(cuid())
  institutionId String           @unique
  institution   Institution      @relation(fields: [institutionId], references: [id])
  // Free platform subdomain; defaults to the institution slug.
  subdomain     String           @unique
  templateKey   String?
  // { primary, accent, font, radius, mode }
  theme         Json
  // { header: [{ label, labelBn?, href, children? }], footer: [...] }
  navigation    Json
  // { siteName, logoUrl, faviconUrl, social{}, analyticsId?, defaultLanguage,
  //   languages[], liteMode, publicResults, showToppers, establishedYear? }
  settings      Json
  status        SiteStatus       @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  pages         SitePage[]
  domains       SiteDomain[]
  posts         SitePost[]
  forms         SiteForm[]
  products      SiteProduct[]
  courses       SiteCourse[]
  customers     SiteCustomer[]
  orders        SiteOrder[]
  enrollments   SiteEnrollment[]

  // ── Website v3 — Sites portal data (Track B2) ──────────────────────
  committeeMembers   SiteCommitteeMember[]
  albums             SiteAlbum[]
  downloads          SiteDownload[]
  admissionCirculars SiteAdmissionCircular[]
}

model SitePage {
  id                 String            @id @default(cuid())
  siteId             String
  site               Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId      String
  // '' = home page
  slug               String
  title              String
  titleBn            String?
  // { title, description, ogImage, noindex }
  seo                Json
  // Puck Data: { root: { props }, content: [{ type, props }], zones? }
  draft              Json
  published          Json?
  publishedAt        DateTime?
  sortOrder          Int               @default(0)
  // The home page is a system page and cannot be deleted.
  isSystem           Boolean           @default(false)
  scheduledPublishAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  versions           SitePageVersion[]

  @@unique([siteId, slug])
  @@index([institutionId])
  @@index([scheduledPublishAt])
}

// Snapshot of a page's Puck data (on publish, restore, template apply or an
// explicit checkpoint). Only the newest 30 per page are kept.
model SitePageVersion {
  id              String   @id @default(cuid())
  pageId          String
  page            SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data            Json
  createdByUserId String
  note            String?
  createdAt       DateTime @default(now())

  @@index([pageId, createdAt])
}

// Metadata only — the browser uploads straight to Cloudinary.
model SiteMedia {
  id              String        @id @default(cuid())
  institutionId   String
  institution     Institution   @relation(fields: [institutionId], references: [id])
  url             String
  kind            SiteMediaKind @default(IMAGE)
  name            String
  size            Int?
  width           Int?
  height          Int?
  alt             String?
  createdByUserId String
  createdAt       DateTime      @default(now())

  @@index([institutionId, createdAt])
}

model SiteDomain {
  id                String           @id @default(cuid())
  siteId            String
  site              Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId     String
  // Always stored lowercase, without port or trailing dot.
  hostname          String           @unique
  isPrimary         Boolean          @default(false)
  status            SiteDomainStatus @default(PENDING_DNS)
  verificationToken String
  // vercel | cloudflare | caddy | manual
  provider          String           @default("manual")
  providerRef       String?
  lastCheckedAt     DateTime?
  error             String?
  // Manual/demo provider: DNS verified here, SSL must be set up by the operator.
  isDemo            Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([siteId])
  @@index([institutionId])
  @@index([status])
}

// Blog / news. Status reuses SiteStatus (DRAFT/PUBLISHED); a PUBLISHED post
// with a future publishedAt stays hidden until then (scheduled post).
model SitePost {
  id            String     @id @default(cuid())
  siteId        String
  site          Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId String
  slug          String
  title         String
  excerpt       String?
  coverUrl      String?
  body          Json
  status        SiteStatus @default(DRAFT)
  publishedAt   DateTime?
  authorUserId  String
  tags          String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([siteId, slug])
  @@index([institutionId])
  @@index([siteId, status, publishedAt])
}

model SiteForm {
  id            String               @id @default(cuid())
  siteId        String
  site          Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId String
  name          String
  // [{ key, label, type, required, options? }]
  fields        Json
  target        SiteFormTarget       @default(INBOX)
  notifyEmails  String[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  submissions   SiteFormSubmission[]

  @@index([siteId])
  @@index([institutionId])
}

model SiteFormSubmission {
  id            String    @id @default(cuid())
  formId        String
  form          SiteForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  institutionId String
  data          Json
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  readAt        DateTime?

  @@index([formId, createdAt])
  @@index([institutionId])
}

// ══════════════════════════════════════════════════════════════════════
// Website Builder v2 — Shop (commerce) and Courses (LMS). Additive to the
// Sites block above; see docs/redesign/WEBSITE_V2_BRIEF.md §2.
// ══════════════════════════════════════════════════════════════════════

enum SiteProductKind {
  PHYSICAL
  DIGITAL
}

enum SiteLessonKind {
  VIDEO
  TEXT
  FILE
  EMBED
}

enum SiteOrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum SiteOrderPaymentMethod {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
  FREE
}

enum SiteEnrollmentStatus {
  ACTIVE
  REVOKED
}

model SiteProduct {
  id             String          @id @default(cuid())
  siteId         String
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId  String
  slug           String
  name           String
  nameBn         String?
  // Sanitised HTML; may be ''.
  description    String          @db.Text
  images         String[]
  price          Decimal         @db.Decimal(12, 2)
  compareAtPrice Decimal?        @db.Decimal(12, 2)
  sku            String?
  // null = unlimited stock
  stock          Int?
  category       String?
  kind           SiteProductKind @default(PHYSICAL)
  // Never returned by the public API; revealed only on a PAID order.
  digitalUrl     String?
  status         SiteStatus      @default(DRAFT)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([siteId, slug])
  @@index([institutionId])
  @@index([siteId, status])
}

model SiteCourse {
  id              String             @id @default(cuid())
  siteId          String
  site            Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId   String
  slug            String
  title           String
  titleBn         String?
  summary         String?
  description     String             @db.Text
  coverUrl        String?
  // 0 = free
  price           Decimal            @default(0) @db.Decimal(12, 2)
  compareAtPrice  Decimal?           @db.Decimal(12, 2)
  level           String?
  language        String?
  category        String?
  instructorName  String?
  instructorBio   String?
  instructorPhoto String?
  durationText    String?
  status          SiteStatus         @default(DRAFT)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lessons         SiteCourseLesson[]
  enrollments     SiteEnrollment[]

  @@unique([siteId, slug])
  @@index([institutionId])
  @@index([siteId, status])
}

// Lessons with the same `module` are grouped into a section in the curriculum.
model SiteCourseLesson {
  id            String               @id @default(cuid())
  courseId      String
  course        SiteCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  institutionId String
  module        String?
  title         String
  kind          SiteLessonKind       @default(VIDEO)
  videoUrl      String?
  // Sanitised HTML.
  body          String?              @db.Text
  fileUrl       String?
  durationMin   Int?
  isFreePreview Boolean              @default(false)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  progress      SiteLessonProgress[]

  @@index([courseId, sortOrder])
  @@index([institutionId])
}

// Shop buyer / course learner account, scoped per site (one school website).
model SiteCustomer {
  id            String           @id @default(cuid())
  siteId        String
  site          Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId String
  // Always stored lowercase.
  email         String
  name          String
  phone         String?
  // Set to an unguessable random hash when an admin grants access before the
  // learner has registered; register() then sets the real password and
  // "claims" the account (sites.customer.auth.ts).
  passwordHash  String
  lastLoginAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  orders        SiteOrder[]
  enrollments   SiteEnrollment[]

  @@unique([siteId, email])
  @@index([institutionId])
}

model SiteOrder {
  id               String                 @id @default(cuid())
  siteId           String
  site             Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId    String
  // e.g. SO-260929-7K3F
  orderNo          String                 @unique
  customerId       String?
  customer         SiteCustomer?          @relation(fields: [customerId], references: [id])
  customerName     String
  email            String
  phone            String
  // { line1, city, area?, postcode? }
  address          Json?
  // [{ kind: 'PRODUCT' | 'COURSE', refId, name, unitPrice, qty }] — server-priced snapshot
  items            Json
  subtotal         Decimal                @db.Decimal(12, 2)
  shipping         Decimal                @default(0) @db.Decimal(12, 2)
  total            Decimal                @db.Decimal(12, 2)
  currency         String                 @default("BDT")
  status           SiteOrderStatus        @default(PENDING)
  paymentMethod    SiteOrderPaymentMethod
  gatewayTranId    String?                @unique
  // bKash paymentID / Nagad paymentReferenceId returned at initiate time —
  // needed to correlate the async callback back to this order (bKash's
  // callback carries only paymentID + status, not our tranId). Internal only;
  // never exposed by the public or admin API.
  gatewayPaymentId String?
  gatewayRef       String?                @unique
  isDemo           Boolean                @default(false)
  returnUrl        String?
  paidAt           DateTime?
  note             String?
  adminNote        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  enrollments      SiteEnrollment[]

  @@index([siteId, status])
  @@index([institutionId])
  @@index([customerId])
}

model SiteEnrollment {
  id            String               @id @default(cuid())
  siteId        String
  site          Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  courseId      String
  course        SiteCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  customerId    String
  customer      SiteCustomer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  institutionId String
  orderId       String?
  order         SiteOrder?           @relation(fields: [orderId], references: [id])
  status        SiteEnrollmentStatus @default(ACTIVE)
  createdAt     DateTime             @default(now())
  progress      SiteLessonProgress[]

  @@unique([courseId, customerId])
  @@index([institutionId])
  @@index([siteId])
}

// No institutionId: tenant isolation is enforced through the parent
// enrollment (customer/course/site), which every query joins through.
model SiteLessonProgress {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   SiteEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       SiteCourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime         @default(now())

  @@unique([enrollmentId, lessonId])
}

// =============================================================================
// Website v3 — Sites portal data (Track B2). Additive to the Sites blocks
// above; see docs/redesign/WEBSITE_V3_PLAN.md §3 Track B / §7.
// Album/download status reuse the existing SiteStatus enum (DRAFT/PUBLISHED)
// rather than a new one — an admission circular's "closed" state is derived
// from endDate at read time, not stored, to avoid a second nearly-identical
// enum.
// =============================================================================

model SiteCommitteeMember {
  id            String      @id @default(cuid())
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  nameBn        String?
  role          String // e.g. "Chairman / সভাপতি"
  roleBn        String?
  photoUrl      String?
  phone         String?
  // Phone is never in the public API response unless this is true.
  showPhone     Boolean     @default(false)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([siteId])
  @@index([institutionId])
}

model SiteAlbum {
  id            String           @id @default(cuid())
  siteId        String
  site          Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id])
  title         String
  titleBn       String?
  coverUrl      String?
  description   String?          @db.Text
  eventDate     DateTime?
  status        SiteStatus       @default(DRAFT)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  photos        SiteAlbumPhoto[]

  @@index([siteId, status])
  @@index([institutionId])
}

model SiteAlbumPhoto {
  id        String    @id @default(cuid())
  albumId   String
  album     SiteAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([albumId])
}

model SiteDownload {
  id            String      @id @default(cuid())
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  title         String
  titleBn       String?
  category      String // e.g. "Syllabus", "Notice", "Form"
  fileUrl       String
  publishedAt   DateTime?
  status        SiteStatus  @default(DRAFT)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([siteId, status, category])
  @@index([institutionId])
}

model SiteAdmissionCircular {
  id            String      @id @default(cuid())
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  session       String // e.g. "2027"
  classNames    String[] // free-text class names this circular covers
  title         String
  titleBn       String?
  body          String      @db.Text // sanitised HTML
  startDate     DateTime?
  endDate       DateTime?
  fee           Decimal?    @db.Decimal(10, 2)
  pdfUrl        String?
  applyUrl      String?
  // Loosely references SiteForm.id (not a DB foreign key — checked at the
  // service layer — so deleting a form never blocks deleting/keeping a
  // circular that once pointed at it).
  formId        String?
  status        SiteStatus  @default(DRAFT)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([siteId, status])
  @@index([institutionId])
}

// =============================================================================
// Email delivery (Website v3 plan, Track A)
// =============================================================================

enum EmailPriority {
  P0_SECURITY
  P1_TRANSACTIONAL
  P2_BULK
}

enum EmailLogStatus {
  QUEUED
  SENT
  DEFERRED
  SKIPPED
  SUPPRESSED
  FAILED
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  SPAM
  BLOCKED
  INVALID
  UNSUBSCRIBED
  MANUAL
}

// ALL = never email this address; BULK = only broadcast mail (campaigns,
// newsletters) is stopped — receipts, OTPs and resets still go.
enum EmailSuppressionScope {
  ALL
  BULK
}

model EmailSuppression {
  id            String                 @id @default(cuid())
  // Always stored lowercase and trimmed.
  email         String
  scope         EmailSuppressionScope  @default(ALL)
  reason        EmailSuppressionReason
  // brevo-webhook | unsubscribe-link | admin
  source        String
  institutionId String?
  note          String?
  createdAt     DateTime               @default(now())

  @@unique([email, scope])
  @@index([institutionId])
}

// One row per send attempt. `toHash` is sha256(lowercase email) so the log is
// searchable without keeping plain addresses; `toMasked` is for display.
model EmailLog {
  id            String         @id @default(cuid())
  institutionId String?
  template      String
  priority      EmailPriority
  status        EmailLogStatus @default(QUEUED)
  toHash        String
  toMasked      String
  subject       String
  // brevo-api | smtp | demo
  provider      String?
  messageId     String?
  idempotencyKey String?       @unique
  tags          String[]
  error         String?
  // Deferred sends (daily budget spent) are retried from this time.
  notBefore     DateTime?
  lastEvent     String?
  lastEventAt   DateTime?
  createdAt     DateTime       @default(now())
  sentAt        DateTime?

  @@index([status, notBefore])
  @@index([createdAt])
  @@index([institutionId, createdAt])
  @@index([messageId])
  @@index([toHash])
}

// Fee types assigned to a class (Fees > Assign Fees Classes). amount is the
// per-class charge; FeeCategory.amount remains the default suggested value.
model ClassFee {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  classId       String
  class         Class       @relation(fields: [classId], references: [id])
  feeCategoryId String
  feeCategory   FeeCategory @relation(fields: [feeCategoryId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([classId, feeCategoryId])
  @@index([institutionId])
}

// One row per admin-sent custom notification; the per-recipient in-app rows
// live in Notification (type CUSTOM, data.broadcastId = this id).
model NotificationBroadcast {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  title          String
  body           String      @db.Text
  target         String // ALL, STUDENT, GUARDIAN, TEACHER, STAFF
  sentByUserId   String
  recipientCount Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([institutionId])
}



