  studentName        String
  guardianName       String?
  phone              String
  email              String?
  classInterested    String?
  source             String?
  status             EnquiryStatus @default(NEW)
  notes              String?
  assignedToUserId   String?
  assignedTo         User?         @relation(fields: [assignedToUserId], references: [id])
