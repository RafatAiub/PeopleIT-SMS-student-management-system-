// ── Communication ─────────────────────────────────────────────────────
enum CampaignChannel {
  SMS
  EMAIL
  IN_APP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model MessageCampaign {
  id              String          @id @default(cuid())
