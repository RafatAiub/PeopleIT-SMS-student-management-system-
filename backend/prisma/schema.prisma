}

model TransportAssignment {
  id            String           @id @default(cuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id])
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id])
  routeId       String
  route         TransportRoute   @relation(fields: [routeId], references: [id])
  vehicleId     String
  vehicle       TransportVehicle @relation(fields: [vehicleId], references: [id])
  pickupPoint   String?
  assignedAt    DateTime         @default(now())
  stopId        String?
  stop          TransportStop?   @relation(fields: [stopId], references: [id])

  @@unique([institutionId, studentId])
  @@index([institutionId])
  @@index([routeId])
  @@index([vehicleId])
  @@index([stopId])
}

// ── Final Phase: HR & Payroll ────────────────────────────────────────
model StaffProfile {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  userId        String          @unique
  user          User            @relation("StaffUser", fields: [userId], references: [id])
  employeeId    String?
  department    String?
  designation   String?
  joiningDate   DateTime?
  baseSalary    Decimal         @db.Decimal(12, 2)
  status        String          @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  staffRoleId   String?
  staffRole     StaffRole?      @relation(fields: [staffRoleId], references: [id])
  gender        String?
  dateOfBirth   DateTime?
  address       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payrolls      PayrollRecord[]
  idCards       IdCard[]
  salaryComponents StaffSalaryComponent[]

  @@index([institutionId])
  @@index([userId])
  @@index([staffRoleId])
}

// Custom staff roles (Staff Management > Roles & Permissions). permissions
// holds "<module>.<action>" keys, e.g. "student.list".
model StaffRole {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])
  name          String
  permissions   String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  staff         StaffProfile[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model PayrollRecord {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  staffId       String
  staff         StaffProfile @relation(fields: [staffId], references: [id])
  payPeriod     String // e.g., "June 2026"
  baseSalary    Decimal      @db.Decimal(12, 2)
  allowances    Decimal      @default(0) @db.Decimal(12, 2)
  deductions    Decimal      @default(0) @db.Decimal(12, 2)
  netAmount     Decimal      @db.Decimal(12, 2)
  status        String       @default("UNPAID") // PAID, UNPAID, PENDING
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  breakdown     Json?
  payslipNo     String?      @unique

  @@index([institutionId])
  @@index([staffId])
  @@index([status])
}

// ── Staff/Teacher Leave Management ───────────────────────────────────
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])
  name          String
  description   String?
  isPaid        Boolean        @default(true)
  color         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leaveRequests LeaveRequest[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model LeaveRequest {
  id               String      @id @default(cuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id])
  applicantUserId  String
  applicant        User        @relation("LeaveApplicant", fields: [applicantUserId], references: [id])
  // Nullable: STUDENT applicants have no leave-type concept at all (Student
  // Leave skips the Leave Settings catalogue entirely) — only STAFF requests
  // carry a leaveTypeId, enforced in leave.service.ts, not at the DB level.
  leaveTypeId      String?
  leaveType        LeaveType?  @relation(fields: [leaveTypeId], references: [id])
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  totalDays        Int
  reason           String      @db.Text
  status           LeaveStatus @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?       @relation("LeaveReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  reviewerComment  String?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([institutionId])
  @@index([applicantUserId])
  @@index([institutionId, status])
  @@index([institutionId, applicantUserId, status])
  @@index([leaveTypeId])
}

// 💬 Phase Final: Messaging
model Message {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  senderId      String
  sender        User          @relation("SentMessages", fields: [senderId], references: [id])
  receiverId    String
  receiver      User          @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content       String        @db.Text
  read          Boolean       @default(false)
  createdAt     DateTime      @default(now())
  groupId       String?
  group         MessageGroup? @relation(fields: [groupId], references: [id])

  @@index([institutionId])
  @@index([senderId])
  @@index([receiverId])
  @@index([institutionId, receiverId, read])
  @@index([groupId])
}

// ── Smart Dynamic ID Cards ──────────────────────────────────────────
enum IdCardUserType {
  STUDENT
  STAFF
}

model IdCardTemplate {
  id              String         @id @default(cuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id])
  title           String
  applicableTo    IdCardUserType
  layout          String         @default("VERTICAL")
  widthMm         Int            @default(57)
  heightMm        Int            @default(89)
  backgroundImage String?        @db.Text
  logoImage       String?        @db.Text
  signatureImage  String?        @db.Text
  photoStyle      String         @default("CIRCLE")
  photoWidthMm    Int            @default(21)
  photoHeightMm   Int            @default(21)
  primaryColor    String         @default("#7c3aed")
  secondaryColor  String         @default("#0f172a")
  showFields      Json           @default("{\"admissionNo\":true,\"name\":true,\"class\":true,\"fatherName\":true,\"motherName\":true,\"address\":true,\"dob\":true,\"bloodGroup\":true}")
  layoutMode      String         @default("SIMPLE") // SIMPLE | ADVANCED
  canvasElements  Json? // CanvasElement[] — only meaningful when layoutMode = ADVANCED
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cards           IdCard[]

  @@index([institutionId])
}

model IdCard {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])
  templateId    String
  template      IdCardTemplate @relation(fields: [templateId], references: [id])
  userType      IdCardUserType
  studentId     String?
  student       Student?       @relation(fields: [studentId], references: [id])
  staffId       String?
  staff         StaffProfile?  @relation(fields: [staffId], references: [id])
  cardNumber    String         @unique
  verifyToken   String         @unique @default(cuid())
  issuedAt      DateTime       @default(now())
  expiresAt     DateTime?
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())

  @@index([institutionId])
  @@index([studentId])
  @@index([staffId])
  @@index([verifyToken])
  @@index([templateId])
}

// ── Holidays ─────────────────────────────────────────────────────────
// WEEKLY = auto-generated weekly off day (Friday/Saturday by default),
// GOVERNMENT = auto-generated Bangladesh public holiday,
// SCHOOL = added by the school itself (vacations, sports day, etc.).
enum HolidayType {
  WEEKLY
  GOVERNMENT
  SCHOOL
}

// One row per calendar day so each auto-generated holiday can be edited or
// deleted on its own.
model Holiday {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  date          DateTime    @db.Date
  title         String
  description   String?     @db.Text
  type          HolidayType @default(SCHOOL)
  // Moon-sighting based holidays (Eid, Shab-e-Barat, ...) still in the
  // future — the date can move by a day or two.
  isTentative   Boolean     @default(false)
  // Set on auto-generated rows: "weekly:<date>" or "gov:<year>:<slug>:<n>".
  // Lets the government-holiday sync find and update its own rows. Null for
  // holidays the school added itself.
  sourceKey     String?
  // An admin edited this auto-generated row — the sync leaves it alone.
  isCustomized  Boolean     @default(false)
  // Auto-generated rows are soft-deleted so a later sync or visit doesn't
  // bring them back. School-added rows are deleted for real.
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, date, title])
  @@unique([institutionId, sourceKey])
  @@index([institutionId, date])
}

// Marks a session year as already auto-filled, so admin deletions stick
// instead of being re-seeded on the next visit.
model HolidayCalendar {
  id                 String      @id @default(cuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id])
  year               Int
  // JS weekday numbers (0 = Sunday ... 5 = Friday, 6 = Saturday)
  weeklyOffDays      Int[]
  // Where the government holidays came from: "FEED" (the published Bangladesh
  // holiday calendar) or "FALLBACK" (fixed-date national days only, used
  // until the feed publishes that year). Null = not synced yet.
  governmentSource   String?
  governmentSyncedAt DateTime?
  seededAt           DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([institutionId, year])
}

// ── Events ───────────────────────────────────────────────────────────
// School events (sports day, prize giving, parent-teacher meeting, ...)
// published to the chosen audiences for a session year.
enum EventType {
  SINGLE
  MULTIPLE
}

enum EventCategory {
  ACADEMIC
  SPORTS
  CULTURAL
  CELEBRATION
  EXAM
  MEETING
  TRIP
  COMPETITION
  OTHER
}

enum EventAudience {
  STUDENTS
  GUARDIANS
  TEACHERS
  STAFF
}

model Event {
  id              String          @id @default(cuid())
  institutionId   String
  institution     Institution     @relation(fields: [institutionId], references: [id])
  academicYearId  String
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  title           String
  description     String?         @db.Text
  category        EventCategory   @default(OTHER)
  // SINGLE = one day (endDate == startDate); MULTIPLE = a date range.
  type            EventType       @default(SINGLE)
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  // "HH:MM" 24-hour, applies to every day of a multi-day event. Null = all day.
  startTime       String?
  endTime         String?
  venue           String?
  audience        EventAudience[]
  // Compressed in the browser and stored as a data: URL, same as the
  // institution logo — no file storage needed on the host.
  imageUrl        String?         @db.Text
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([institutionId, startDate])
  @@index([academicYearId])
}

// ══════════════════════════════════════════════════════════════════════
// Wave C: feature foundation — additive schema for upcoming feature work
// (online fee payments, concessions, promotions, HR/payroll, library,
// transport, inventory, admissions CRM, custom fields, communications,
// tasks/reviews, exam timetables, SaaS/billing platform layer, AI, and
// saved report views). All models below are new; existing models only
// gained nullable columns, columns with defaults, and indexes.
// ══════════════════════════════════════════════════════════════════════

// ── Online Fee Payments ──────────────────────────────────────────────
enum FeeGateway {
  BKASH
  NAGAD
  SSLCOMMERZ
}

enum FeeTxnStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model FeePaymentTransaction {
  id                   String       @id @default(cuid())
  institutionId        String
  institution          Institution  @relation(fields: [institutionId], references: [id])
  invoiceId            String
  invoice              Invoice      @relation(fields: [invoiceId], references: [id])
  studentId            String?
  student              Student?     @relation(fields: [studentId], references: [id])
  gateway              FeeGateway
  amount               Decimal      @db.Decimal(12, 2)
  currency             String       @default("BDT")
  status               FeeTxnStatus @default(INITIATED)
  gatewayTransactionId String       @unique
  gatewayPaymentId     String?
  gatewayValId         String?      @unique
  rawResponse          Json?
  initiatedByUserId    String?
  initiatedBy          User?        @relation(fields: [initiatedByUserId], references: [id])
  paymentId            String?      @unique
  payment              Payment?     @relation(fields: [paymentId], references: [id])
  isDemo               Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([institutionId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
}

// ── Fee Concessions ──────────────────────────────────────────────────
enum ConcessionType {
  PERCENT
  FIXED
}

model Concession {
  id                 String              @id @default(cuid())
  institutionId      String
  institution        Institution         @relation(fields: [institutionId], references: [id])
  name               String
  type               ConcessionType
  value              Decimal             @db.Decimal(12, 2)
  feeCategoryId      String?
  feeCategory        FeeCategory?        @relation(fields: [feeCategoryId], references: [id])
  isActive           Boolean             @default(true)
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  studentConcessions StudentConcession[]

  @@index([institutionId])
  @@index([feeCategoryId])
}

model StudentConcession {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  concessionId  String
  concession    Concession  @relation(fields: [concessionId], references: [id])
  validFrom     DateTime?
  validTo       DateTime?
  note          String?
  createdAt     DateTime    @default(now())

  @@unique([studentId, concessionId])
  @@index([institutionId])
  @@index([concessionId])
}

// ── Fee Schedules / Bulk Invoicing ───────────────────────────────────
model FeeSchedule {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  classId       String?
  class         Class?      @relation(fields: [classId], references: [id])
  feeCategoryId String
  feeCategory   FeeCategory @relation(fields: [feeCategoryId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  frequency     String // MONTHLY, TERM, ONE_TIME, ANNUAL
  dueDay        Int?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId])
  @@index([classId])
  @@index([feeCategoryId])
}

model InvoiceBatch {
  id              String      @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id])
  label           String
  classId         String?
  class           Class?      @relation(fields: [classId], references: [id])
  sectionId       String?
  section         Section?    @relation(fields: [sectionId], references: [id])
  period          String
  createdByUserId String
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  invoiceCount    Int         @default(0)
  totalAmount     Decimal     @default(0) @db.Decimal(14, 2)
  status          String      @default("PENDING")
  createdAt       DateTime    @default(now())

  @@index([institutionId])
  @@index([classId])
  @@index([sectionId])
}

// ── Grading Scales ───────────────────────────────────────────────────
model GradingScale {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bands         GradeBand[]

  @@index([institutionId])
}

// Scoped transitively through gradingScaleId — same pattern as InvoiceItem
// and Payment, which have no institutionId of their own either.
model GradeBand {
  id             String       @id @default(cuid())
  gradingScaleId String
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id])
  grade          String
  minPercent     Decimal      @db.Decimal(5, 2)
  maxPercent     Decimal      @db.Decimal(5, 2)
  gradePoint     Decimal      @db.Decimal(3, 2)
  remark         String?

  @@unique([gradingScaleId, grade])
  @@index([gradingScaleId])
}

// ── Promotion ─────────────────────────────────────────────────────────
enum PromotionStatus {
  PROMOTED
  RETAINED
  GRADUATED
  TRANSFERRED
}

model PromotionRecord {
  id                 String          @id @default(cuid())
  institutionId      String
  institution        Institution     @relation(fields: [institutionId], references: [id])
  studentId          String
  student            Student         @relation(fields: [studentId], references: [id])
  fromAcademicYearId String?
  fromAcademicYear   AcademicYear?   @relation("PromotionFromYear", fields: [fromAcademicYearId], references: [id])
  toAcademicYearId   String?
  toAcademicYear     AcademicYear?   @relation("PromotionToYear", fields: [toAcademicYearId], references: [id])
  fromClassId        String?
  fromClass          Class?          @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClassId          String?
  toClass            Class?          @relation("PromotionToClass", fields: [toClassId], references: [id])
  fromSectionId      String?
  fromSection        Section?        @relation("PromotionFromSection", fields: [fromSectionId], references: [id])
  toSectionId        String?
  toSection          Section?        @relation("PromotionToSection", fields: [toSectionId], references: [id])
  status             PromotionStatus
  promotedByUserId   String
  promotedBy         User            @relation(fields: [promotedByUserId], references: [id])
  note               String?
  createdAt          DateTime        @default(now())

  @@index([institutionId])
  @@index([studentId])
}

// ── Attendance Extensions ────────────────────────────────────────────
model SubjectAttendance {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id])
  subjectId      String?
  subject        Subject?    @relation(fields: [subjectId], references: [id])
  subjectName    String
  date           DateTime    @db.Date
  period         Int?
  status         String // PRESENT, ABSENT, LATE, HALF_DAY
  markedByUserId String
  markedBy       User        @relation(fields: [markedByUserId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([institutionId, studentId, date, subjectName, period])
  @@index([institutionId])
  @@index([studentId])
  @@index([subjectId])
}

model StaffAttendance {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  staffUserId    String
  staffUser      User        @relation("StaffAttendanceStaff", fields: [staffUserId], references: [id])
  date           DateTime    @db.Date
  status         String
  checkIn        DateTime?
  checkOut       DateTime?
  note           String?
  markedByUserId String?
  markedBy       User?       @relation("StaffAttendanceMarker", fields: [markedByUserId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([institutionId, staffUserId, date])
  @@index([institutionId])
  @@index([staffUserId])
}

model QrCheckIn {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  studentId     String?
  student       Student?    @relation(fields: [studentId], references: [id])
  scannedAt     DateTime    @default(now())
  method        String      @default("QR")
  deviceInfo    String?
  createdAt     DateTime    @default(now())

  @@index([institutionId])
  @@index([userId])
  @@index([studentId])
}

// ── Payroll Components ───────────────────────────────────────────────
enum SalaryComponentType {
  ALLOWANCE
  DEDUCTION
}

enum SalaryCalcType {
  FIXED
  PERCENT_OF_BASE
}

model SalaryComponent {
  id             String                 @id @default(cuid())
  institutionId  String
  institution    Institution            @relation(fields: [institutionId], references: [id])
  name           String
  type           SalaryComponentType
  calcType       SalaryCalcType
  value          Decimal                @db.Decimal(12, 2)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  staffOverrides StaffSalaryComponent[]

  @@index([institutionId])
}

model StaffSalaryComponent {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  staffId       String
  staff         StaffProfile    @relation(fields: [staffId], references: [id])
  componentId   String
  component     SalaryComponent @relation(fields: [componentId], references: [id])
  overrideValue Decimal?        @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())

  @@unique([staffId, componentId])
  @@index([institutionId])
  @@index([componentId])
}

// ── Library Fine Rules ───────────────────────────────────────────────
model LibraryFineRule {
  id            String      @id @default(cuid())
  institutionId String      @unique
  institution   Institution @relation(fields: [institutionId], references: [id])
  finePerDay    Decimal     @db.Decimal(10, 2)
  graceDays     Int         @default(0)
  maxFine       Decimal?    @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ── Transport Stops (route-tracking readiness) ───────────────────────
model TransportStop {
  id            String                @id @default(cuid())
  institutionId String
  institution   Institution           @relation(fields: [institutionId], references: [id])
  routeId       String
  route         TransportRoute        @relation(fields: [routeId], references: [id])
  name          String
  sequence      Int
  pickupTime    String?
  dropTime      String?
  lat           Float?
  lng           Float?
  createdAt     DateTime              @default(now())
  assignments   TransportAssignment[]

  @@index([institutionId])
  @@index([routeId])
}

// ── Inventory & Assets ────────────────────────────────────────────────
enum AssetStatus {
  AVAILABLE
  ALLOCATED
  MAINTENANCE
  RETIRED
  LOST
}

// Also used for StockItem.category — one institution-scoped catalogue of
// tags shared by fixed assets and consumable stock.
model AssetCategory {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  createdAt     DateTime    @default(now())
  assets        Asset[]
  stockItems    StockItem[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Asset {
  id            String             @id @default(cuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id])
  categoryId    String?
  category      AssetCategory?     @relation(fields: [categoryId], references: [id])
  name          String
  code          String
  serialNo      String?
  purchaseDate  DateTime?
  purchaseCost  Decimal?           @db.Decimal(12, 2)
  vendor        String?
  location      String?
  status        AssetStatus        @default(AVAILABLE)
  condition     String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  allocations   AssetAllocation[]
  maintenances  AssetMaintenance[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([categoryId])
  @@index([status])
}

model AssetAllocation {
  id                  String      @id @default(cuid())
  institutionId       String
  institution         Institution @relation(fields: [institutionId], references: [id])
  assetId             String
  asset               Asset       @relation(fields: [assetId], references: [id])
  allocatedToUserId   String?
  allocatedToUser     User?       @relation(fields: [allocatedToUserId], references: [id])
  allocatedToLocation String?
  allocatedAt         DateTime    @default(now())
  returnedAt          DateTime?
  note                String?

  @@index([institutionId])
  @@index([assetId])
  @@index([allocatedToUserId])
}

model AssetMaintenance {
