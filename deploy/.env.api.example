# Copy to /opt/peoplenit/.env.api on the VPS: the backend's own settings.
# NODE_ENV, PORT, TRUST_PROXY, REDIS_URL and DATA_EXPORT_DIR are set by
# docker-compose.prod.yml. Everything else the backend reads goes here; see
# the repo's .env.example for the full list and meanings.

APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
QR_SECRET=

# Email (Brevo)
EMAIL_ENABLED=true
EMAIL_FROM=no-reply@eoncodigital.com
BREVO_API_KEY=
EMAIL_WEBHOOK_TOKEN=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Must be false on a live system: a demo "success" marks real invoices and orders paid.
FEE_DEMO_PAYMENTS_ENABLED=false

# School websites: Caddy issues certificates for verified school domains.
SITES_DOMAIN_PROVIDER=caddy
PLATFORM_SITE_DOMAIN=sites.example.com

# Payment gateways, SMS, AI, Sentry: copy the names and values you use today.
