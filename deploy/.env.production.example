# Copy to /opt/peoplenit/.env on the VPS (read by docker compose and deploy.sh).
# Never commit the real file.

# Images built by GitHub Actions: ghcr.io/<github-owner>/<repo-name> in lowercase
IMAGE_PREFIX=ghcr.io/your-github-owner/peopleit-sms-student-management-system-
# Only needed if the GHCR packages are private: a GitHub token with read:packages
GHCR_USER=
GHCR_TOKEN=

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Long random string; the API gets it through REDIS_URL in docker-compose.prod.yml
REDIS_PASSWORD=change-me-to-a-long-random-string
