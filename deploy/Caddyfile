# Domains come from the environment (see deploy/.env.production.example):
#   APP_DOMAIN     dashboard + public API path   e.g. app.example.com
#   API_DOMAIN     API only (gateway callbacks)   e.g. api.example.com
#   ACME_EMAIL     Let's Encrypt contact
{
	email {$ACME_EMAIL}
	# School custom domains and platform subdomains get a certificate only
	# when the API says the hostname belongs to a site (verified domain).
	on_demand_tls {
		ask http://api:3001/api/v1/public/sites/caddy-ask
	}
	servers {
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

(spa) {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:3001
	}
	handle /health {
		reverse_proxy api:3001
	}
	handle {
		root * /srv
		# Hashed build assets can be cached forever; index.html never.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$APP_DOMAIN} {
	import security_headers
	# The dashboard must not be framed by other sites.
	header X-Frame-Options SAMEORIGIN
	import spa
}

{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy api:3001
}

# Every other hostname: a school's website (custom domain or platform
# subdomain). The frontend detects site hosts and renders the public site.
https:// {
	tls {
		on_demand
	}
	import security_headers
	import spa
}
