# Backend API base URL (defaults to /api/v1 if unset)
VITE_API_URL=

# Cloudinary — powers direct-from-browser file uploads for lecture material
# and classwork attachments (video/image/PDF). Both values are safe to
# expose in the frontend; there is no API secret here.
#
# Setup:
#   1. Create a free account at https://cloudinary.com
#   2. Copy your "Cloud name" from the dashboard
#   3. Go to Settings -> Upload -> Upload presets -> Add upload preset
#      - Set "Signing Mode" to "Unsigned"
#      - (Optional but recommended) restrict allowed formats to
#        jpg,png,webp,mp4,mov,pdf and set a max file size
#   4. Paste the cloud name and preset name below
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
